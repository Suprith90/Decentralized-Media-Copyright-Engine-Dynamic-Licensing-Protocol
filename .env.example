# Aegis Copyright Engine Environment Variables Example
# Copy this file to '.env' and modify as necessary

# ==============================================================================
# 1. Backend Processor Configuration (media_processor)
# ==============================================================================
# Port and Host for the FastAPI server
PORT=8000
HOST=0.0.0.0

# Local or Remote Ethereum Node RPC URL
HARDHAT_PROVIDER_URL=http://127.0.0.1:8545

# Ethereum private key used by the backend to sign copyright mint transactions.
# DEFAULT: Hardhat Account #0 default local private key (pre-funded on localhost)
BACKEND_MINT_ACCOUNT=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BACKEND_MINT_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80


# ==============================================================================
# 2. Frontend Application Configuration (frontend)
# ==============================================================================
# API Endpoint of the FastAPI backend service
VITE_BACKEND_URL=http://localhost:8000

# Local RPC Provider URL for fallback view-only database interaction
VITE_PROVIDER_URL=http://127.0.0.1:8545
